# Set to production in production deploys (affects 500 error message exposure)
ENVIRONMENT=dev
# Comma-separated origins for CORS (e.g. https://app.example.com,https://admin.example.com)
ALLOWED_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sniper
# Optional: connection pool (defaults shown)
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_RECYCLE_SECONDS=300
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
DATA_ENCRYPTION_KEY=
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_DEPLOY_KEY=
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_BACKEND=ibm_brisbane
ENABLE_QUANTUM_ROUTING=true
ENABLE_QUANTUM_PORTFOLIO=true
ENABLE_QUANTUM_HEDGING=true
QUANTUM_ROUTING_MIN_ORDER_SIZE=100000
QUANTUM_PORTFOLIO_MIN_ASSETS=50
QUANTUM_HEDGING_MIN_POSITIONS=10
QUANTUM_TIMEOUT_MS=5000
MANDATORY_ANALYSIS_HEARTBEAT_SECONDS=45
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
BROKER_PROVIDER=paper
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_ACCESS_TOKEN=
# AI Trading Copilot (OpenAI) - required for /api/v1/ai/chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REQUEST_TIMEOUT_SECONDS=45
OPENAI_RETRY_DELAY_SECONDS=1.5
OPENAI_MAX_RETRIES=1

MAX_DAILY_LOSS_PCT=0.02
MAX_DRAWDOWN_PCT=0.10
MAX_DELTA=500
MAX_GAMMA=50
MAX_VEGA=10000

# Required to deactivate circuit breaker (use a strong secret in production)
CIRCUIT_BREAKER_ADMIN_SECRET=

# Optional: Clerk JWKS URL to accept Clerk JWTs (Frontend API URL + /.well-known/jwks.json)
# Example: https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
