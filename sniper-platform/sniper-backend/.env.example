DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sniper
REDIS_URL=redis://localhost:6379/0
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_BACKEND=ibm_brisbane
ENABLE_QUANTUM_ROUTING=true
ENABLE_QUANTUM_PORTFOLIO=true
ENABLE_QUANTUM_HEDGING=true
QUANTUM_ROUTING_MIN_ORDER_SIZE=100000
QUANTUM_PORTFOLIO_MIN_ASSETS=50
QUANTUM_HEDGING_MIN_POSITIONS=10
QUANTUM_TIMEOUT_MS=5000
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
MAX_DAILY_LOSS_PCT=0.02
MAX_DRAWDOWN_PCT=0.10
MAX_DELTA=0.30
MAX_GAMMA=0.05
MAX_VEGA=10000
