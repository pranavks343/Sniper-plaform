# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Sniper Trading Backend
# Options: dev | staging | production
ENVIRONMENT=dev
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sniper
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# ── Clerk Authentication ──────────────────────────────────────────────────────
# Enables Clerk JWT verification for API tokens (recommended in production)
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

DATA_ENCRYPTION_KEY=
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_DEPLOY_KEY=
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_BACKEND=ibm_brisbane
ENABLE_QUANTUM_ROUTING=true
ENABLE_QUANTUM_PORTFOLIO=true
ENABLE_QUANTUM_HEDGING=true
QUANTUM_ROUTING_MIN_ORDER_SIZE=100000
QUANTUM_PORTFOLIO_MIN_ASSETS=50
QUANTUM_HEDGING_MIN_POSITIONS=10
QUANTUM_TIMEOUT_MS=5000
MANDATORY_ANALYSIS_HEARTBEAT_SECONDS=45
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
BROKER_PROVIDER=paper
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_ACCESS_TOKEN=
# AI Trading Copilot (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REQUEST_TIMEOUT_SECONDS=45
OPENAI_RETRY_DELAY_SECONDS=1.5
OPENAI_MAX_RETRIES=1

MAX_DAILY_LOSS_PCT=0.02
MAX_DRAWDOWN_PCT=0.10
MAX_DELTA=500
MAX_GAMMA=50
MAX_VEGA=10000
